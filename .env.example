# Copy to .env (never commit .env: it is gitignored), or just run
#   npm run auth:setup
# which creates .env, the secret and a QR code to scan.
# The server reads the repo-root .env at startup; variables already set in the
# environment (shell, Docker, the e2e config) win over this file.
#
# The server is the hub: it keeps the versions devices push, and hosts the web
# app. Each device keeps its own copy and works on it; only sync reaches here.

# --- Pairing devices --------------------------------------------------------
# "totp" (default): connecting a device (Sync in the app) takes the 6-digit code
#   from Google Authenticator (or any authenticator app). Needs KM_TOTP_SECRET.
# "off": anyone who reaches the server can connect and push. Only for a server
#   nobody else can reach.
KM_AUTH=totp

# The authenticator secret (base32). Made by `npm run auth:setup`, which also
# shows the QR code to scan. Keep it secret: it is the key to your data.
KM_TOTP_SECRET=

# --- Versions ---------------------------------------------------------------
# How many versions the hub keeps (older ones are dropped).
KM_HUB_KEEP_VERSIONS=100
