# Copy to .env (never commit .env: it is gitignored), or just run
#   npm run auth:setup
# which creates .env, the secret and a QR code to scan.
# The server reads the repo-root .env at startup; variables already set in the
# environment (shell, Docker, the e2e config) win over this file.

# --- Sign-in --------------------------------------------------------------
# "totp" (default): sign in with the 6-digit code from Google Authenticator
#   (or any authenticator app). Needs KM_TOTP_SECRET.
# "off": no sign-in at all. Only for a server nobody else can reach.
KM_AUTH=totp

# The authenticator secret (base32). Made by `npm run auth:setup`, which also
# shows the QR code to scan. Keep it secret: it is the key to your data.
KM_TOTP_SECRET=

# How long a sign-in lasts before the app asks for a new code (hours).
KM_SESSION_HOURS=168

# true when you open the app over https:// (e.g. behind a reverse proxy): the
# session cookie is then never sent over plain http.
KM_COOKIE_SECURE=false
